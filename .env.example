# ── TRADE_BOT_V2 ── copy to .env, never commit the real file ──────────────

# AI (required)
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-fable-5

# Markets
TRADE_US=true
TRADE_INDIA=true

# Virtual paper capital
US_START_CASH=3000
INDIA_START_CASH=250000

# Alpaca paper mirror (optional — leave blank to use only the local ledger)
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Telegram (same as V1)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── HARD RISK CAPS (code-enforced; AI cannot override) ────────────────────
CAP_MAX_POSITION_PCT=0.20
CAP_MAX_RISK_PER_TRADE_PCT=0.015
CAP_MAX_OPEN_POSITIONS=6
CAP_MAX_NEW_ENTRIES_PER_DAY=2
CAP_DAILY_LOSS_HALT_PCT=0.03
CAP_MAX_DRAWDOWN_KILL_PCT=0.10

# Ops
BOTV2_DB=botv2.db
LOG_LEVEL=INFO
AI_DECISION_MAX_TOKENS=4000

# Simulated trading costs per side (fees + slippage, fraction of price)
US_COST_PCT=0.0005
INDIA_COST_PCT=0.0015

# Supabase journal backend (optional — leave blank to use local SQLite)
# Use the SECRET key (sb_secret_...), not the publishable one.
SUPABASE_URL=
SUPABASE_KEY=
