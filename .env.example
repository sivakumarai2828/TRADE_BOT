# ── TRADE_BOT_V2 ── copy to .env, never commit the real file ──────────────

# AI (required)
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-fable-5

# Markets
TRADE_US=true
TRADE_INDIA=true
# India: "suggest" = no orders at all, a ranked list of buy suggestions each day
# (Telegram + dashboard). "trade" = the bot runs an India paper book.
INDIA_MODE=suggest
# US: "trade" (default) keeps trading and also lists each day's ideas as ranked
# suggestions on the dashboard. "suggest" = US suggestions only, no orders.
US_MODE=trade

# Virtual paper capital
US_START_CASH=3000
INDIA_START_CASH=250000

# Alpaca paper mirror (optional — leave blank to use only the local ledger)
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Telegram (same as V1)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Desk gates (v3) ───────────────────────────────────────────────────────
# Skeptic: second AI pass that argues against every new entry (fail-closed)
SKEPTIC_ENABLED=true
# Blank = same model as the PM. A different model is a more independent check.
SKEPTIC_MODEL=
# telegram = every new entry waits for your Approve tap; off = fill immediately
APPROVAL_MODE=telegram
# Requests also expire at that market's close, whichever is first
APPROVAL_TIMEOUT_MIN=390
# Cancel an approved entry if price ran more than this above the proposal
APPROVAL_MAX_DRIFT_PCT=0.015

# Control dashboard (/control on the API). Leave blank to keep controls off.
# Use a long random string, e.g.  python -c "import secrets;print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=

# ── HARD RISK CAPS (code-enforced; AI cannot override) ────────────────────
CAP_MAX_POSITION_PCT=0.20
CAP_MAX_RISK_PER_TRADE_PCT=0.015
CAP_MAX_OPEN_POSITIONS=6
CAP_MAX_NEW_ENTRIES_PER_DAY=2
CAP_DAILY_LOSS_HALT_PCT=0.03
CAP_MAX_DRAWDOWN_KILL_PCT=0.10

# Ops
BOTV2_DB=botv2.db
LOG_LEVEL=INFO
AI_DECISION_MAX_TOKENS=4000

# Simulated trading costs per side (fees + slippage, fraction of price)
US_COST_PCT=0.0005
INDIA_COST_PCT=0.0015

# Supabase journal backend (optional — leave blank to use local SQLite)
# Use the SECRET key (sb_secret_...), not the publishable one.
SUPABASE_URL=
SUPABASE_KEY=

# ── Options desk (PAPER ONLY) ─────────────────────────────────────────────
# One small call per US idea that passed the checks, bought only on Approve.
# Virtual fills at real delayed quotes; no broker order is placed.
OPTIONS_ENABLED=false
OPT_BUDGET_USD=50
# Sell when the bid reaches this multiple of the price paid (2 = $50 -> $100)
OPT_TARGET_MULT=2.0
OPT_EXIT_DTE=7
OPT_DTE_MIN=30
OPT_DTE_MAX=60
OPT_MAX_OPEN=3
OPT_MIN_OPEN_INTEREST=100
OPT_MAX_SPREAD_PCT=0.30
# Strike at most this far above the stock price; no contracts under OPT_MIN_ASK
OPT_MAX_OTM_PCT=0.25
OPT_MIN_ASK=0.10
OPT_START_CASH=500
