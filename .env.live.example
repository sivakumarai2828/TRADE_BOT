# ── TRADE_BOT_V3 broker mode ── copy to .env.live on the VM, chmod 600, never commit
# Used only by trade-bot-live.service. Nothing is read from .env.
#
# STEP 1 (now):  Alpaca PAPER keys + paper URL. Real orders, fake money.
# STEP 2 (later, only if paper meets your readiness checklist):
#                LIVE keys + live URL + LIVE_REAL_MONEY=true.

BROKER_TRADING=true
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_BASE_URL=https://api.alpaca.markets
LIVE_REAL_MONEY=false

# Hard ceiling on any single buy, in dollars
MAX_ORDER_USD=150

# Own journal, never the paper bot's Supabase
BOTV2_DB=botv2_live.db
SUPABASE_URL=
SUPABASE_KEY=

TRADE_US=true
TRADE_INDIA=false

# Every entry waits for your Approve tap. Required in broker mode.
APPROVAL_MODE=telegram
APPROVAL_TIMEOUT_MIN=90
APPROVAL_MAX_DRIFT_PCT=0.015
# Use a SEPARATE Telegram bot (new token from @BotFather) if the paper bot
# keeps running: two processes polling one token steal each other's taps.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# AI (same as .env)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_MODEL=
SKEPTIC_ENABLED=true
SKEPTIC_MODEL=

# Small account (~$450): fewer, larger positions so whole shares fit.
CAP_MAX_POSITION_PCT=0.33
CAP_MAX_RISK_PER_TRADE_PCT=0.015
CAP_MAX_OPEN_POSITIONS=3
CAP_MAX_NEW_ENTRIES_PER_DAY=1
CAP_DAILY_LOSS_HALT_PCT=0.03
CAP_MAX_DRAWDOWN_KILL_PCT=0.10

LOG_LEVEL=INFO
