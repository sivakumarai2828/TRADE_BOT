[Unit]
Description=AI Trade Bot V3 - dashboard for the Alpaca broker bot (view only, localhost)
After=network.target
StartLimitIntervalSec=0

[Service]
User=__USER__
WorkingDirectory=/home/__USER__/TRADE_BOT_V3
# Same settings and journal as trade-bot-live.service. Listens on 127.0.0.1 only.
EnvironmentFile=/home/__USER__/TRADE_BOT_V3/.env.live
Environment=BOTV2_ENV_FILE=.env.live
Environment=TZ=UTC
ExecStart=/home/__USER__/venv311/bin/python3 api_v2.py
Restart=always
RestartSec=30
MemoryMax=300M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
